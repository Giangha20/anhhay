# ========================================================
# PhotoWeb - Environment Configuration Example
# ========================================================

# 1. Khi chạy trên máy tính Windows (ổ D:):
DATABASE_URL="file:../storage/photoweb.db"
STORAGE_PATH="D:\\PhotoWeb\\storage"

# 2. Khi triển khai lên Vercel:
# Đặt biến môi trường trên Vercel Dashboard -> Settings -> Environment Variables:
# DATABASE_URL="file:/tmp/photoweb.db"
# STORAGE_PATH="/tmp/photoweb_storage"

# Session Secret Key
SESSION_SECRET="photoweb-super-secret-production-grade-session-key-2026"

# Server Host & Port
HOST="0.0.0.0"
PORT="3000"

# Initial Admin Credentials (cho seed script ban đầu)
INITIAL_ADMIN_USERNAME="giangtptq"
INITIAL_ADMIN_PASSWORD="Giangha@2k5"
