# ========================================================
# PhotoWeb - Environment Configuration Example
# ========================================================

# 1. Khi chạy trên máy tính Windows (ổ D:):
DATABASE_URL="file:../storage/photoweb.db"
STORAGE_PATH="D:\\PhotoWeb\\storage"

# 2. Khi triển khai lên Vercel:
# (Hệ thống tự động sử dụng /tmp/photoweb.db và fallback linh hoạt)
# DATABASE_URL="file:/tmp/photoweb.db"
# STORAGE_PATH="/tmp/photoweb_storage"

# Server Host & Port
HOST="0.0.0.0"
PORT="3000"
