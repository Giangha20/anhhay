generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Image {
  id            String    @id @default(cuid())
  title         String
  description   String?
  filename      String    @unique
  relativePath  String
  thumbnailPath String?
  format        String
  size          Int
  width         Int?
  height        Int?
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([categoryId])
  @@index([createdAt])
}

model Category {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  description  String?
  coverImage   String?
  displayOrder Int        @default(0)
  isVisible    Boolean    @default(true)
  parentId     String?
  parent       Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("SubCategories")
  images       Image[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([parentId])
  @@index([displayOrder])
}

model SiteSettings {
  id                    String   @id @default("default")
  siteName              String   @default("Ảnh Hay")
  logoUrl               String?
  seoTitle              String   @default("Ảnh Hay - Thư viện ảnh nghệ thuật trực tuyến")
  seoDescription        String   @default("Bộ sưu tập ảnh chất lượng cao và khoảnh khắc nghệ thuật đặc sắc")
  introText             String   @default("Khám phá những khoảnh khắc tuyệt đẹp qua lăng kính nghệ thuật. Thư viện hình ảnh chất lượng cao mở cho tất cả mọi người.")
  footerText            String   @default("© 2026 Ảnh Hay (anhhay). Thư viện ảnh nghệ thuật trực tuyến.")
  contactInfo           String?
  primaryColor          String   @default("#10b981")
  bgColor               String   @default("#0f172a")
  galleryLayout         String   @default("grid")
  cardSize              String   @default("medium")
  defaultTheme          String   @default("dark")
  photosPerPage         Int      @default(12)
  enableAnimations      Boolean  @default(true)
  showHeroSection       Boolean  @default(true)
  showCategoriesSection Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

model ContentBlock {
  id         String   @id @default(cuid())
  type       String
  title      String
  subtitle   String?
  content    String?
  imageUrl   String?
  buttonText String?
  buttonLink String?
  order      Int      @default(0)
  isVisible  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([order])
}
